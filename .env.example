# ==============================================================================
# Environment Configuration — Impact Circles AI Automation
# ==============================================================================

# Database (Neon PostgreSQL)
# Keep Neon credentials secure: do not expose them to client-side code
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Google Gemini API
# Supported multimodal models with JSON schema mode: gemini-flash-latest, gemini-3.1-flash-lite
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-flash-latest"

# n8n Automation
# Local n8n server instance and webhook orchestrator
N8N_BASE_URL="http://localhost:5678"
N8N_WEBHOOK_URL="http://localhost:5678/webhook/impact-circles-ai-automation"
N8N_WEBHOOK_SECRET="REPLACE_WITH_A_SECURE_RANDOM_SECRET"

# Sandbox Publishing Configuration
SANDBOX_BASE_URL="http://localhost:3000"
SANDBOX_API_KEY="sandbox_demo_secret_key"
# Optional comma-separated list of channels to simulate failure (e.g. "linkedin" or "website,newsletter")
SANDBOX_FAIL_CHANNELS=""

# Optional Reviewer Passcode (guards PATCH, approve, and publish routes; skipped if unset)
REVIEWER_PASSCODE=""

