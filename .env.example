# ==============================================================================
# Environment Configuration — Impact Circles AI Automation
# ==============================================================================

# Database (Neon PostgreSQL)
# Keep Neon credentials secure: do not expose them to client-side code
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Google Gemini API
# Supported multimodal models with JSON schema mode: gemini-flash-latest, gemini-3.1-flash-lite
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-flash-latest"

# n8n Automation (Optional — Local or Cloud)
# Uncomment only if you run n8n; otherwise the app uses the built-in direct pipeline.
#
# Option A — Local n8n (http://localhost:5678):
# N8N_BASE_URL="http://localhost:5678"
# N8N_WEBHOOK_URL="http://localhost:5678/webhook/impact-circles-ai-automation"
# N8N_CONTENT_WEBHOOK_URL="http://localhost:5678/webhook/impact-circles-content-publishing"
#
# Option B — n8n Cloud (https://your-instance.app.n8n.cloud):
# N8N_BASE_URL="https://your-instance.app.n8n.cloud"
# N8N_WEBHOOK_URL="https://your-instance.app.n8n.cloud/webhook/impact-circles-ai-automation"
# N8N_CONTENT_WEBHOOK_URL="https://your-instance.app.n8n.cloud/webhook/impact-circles-content-publishing"
#
# Shared Secret for Webhook Authentication (Must match n8n environment N8N_WEBHOOK_SECRET)
# N8N_WEBHOOK_SECRET="REPLACE_WITH_A_SECURE_RANDOM_SECRET"
#
# If running self-hosted n8n, allow node access to env vars:
# N8N_BLOCK_ENV_ACCESS_IN_NODE="false"
# N8N_EXPRESSIONS_ALLOWED_ENV_VARS="N8N_WEBHOOK_SECRET,SANDBOX_BASE_URL,SANDBOX_API_KEY"

# Sandbox Publishing Configuration
# Base URL where n8n and the Next.js app reach the sandbox mock endpoints.
# - Local Next.js + local n8n: "http://localhost:3000"
# - Local Next.js + Docker n8n: "http://host.docker.internal:3000"
# - Local Next.js + hosted n8n Cloud: Reachable public URL (e.g. ngrok or Cloudflare Tunnel)
SANDBOX_BASE_URL="http://localhost:3000"
SANDBOX_API_KEY="sandbox_demo_secret_key"

# Optional comma-separated list of channels to simulate failure (e.g. "linkedin" or "website,newsletter")
SANDBOX_FAIL_CHANNELS=""

# Optional Reviewer Passcode (guards PATCH, approve, and publish routes; skipped if unset)
REVIEWER_PASSCODE=""
