# Database (Neon PostgreSQL)
# keep Neon credentials secure: do not expose them to client-side code
DATABASE_URL="YOUR_NEON_POOLED_CONNECTION_STRING"
DIRECT_URL="YOUR_NEON_DIRECT_CONNECTION_STRING"

# Google Gemini API
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.1-flash-light"

# n8n Automation
N8N_BASE_URL="http://localhost:5678"
N8N_WEBHOOK_URL="http://localhost:5678/webhook/impact-circles-ai-automation"
N8N_WEBHOOK_SECRET="REPLACE_WITH_A_RANDOM_SECRET"
