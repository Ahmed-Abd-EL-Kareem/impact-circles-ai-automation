# ==============================================================================
# Environment Configuration — Impact Circles AI Automation
# ==============================================================================

# Database (Neon PostgreSQL)
# Keep Neon credentials secure: do not expose them to client-side code
DATABASE_URL="postgresql://user:password@ep-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-direct.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Google Gemini API
# Supported multimodal models with JSON schema mode: gemini-flash-latest, gemini-3.1-flash-lite
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-flash-latest"

# n8n Automation
# Local n8n server instance and webhook orchestrator
N8N_BASE_URL="http://localhost:5678"
N8N_WEBHOOK_URL="http://localhost:5678/webhook/impact-circles-ai-automation"
N8N_WEBHOOK_SECRET="REPLACE_WITH_A_SECURE_RANDOM_SECRET"

# Phase 3 — Optional External Publishing Webhooks (Demonstration sandbox used if omitted)
# CMS_WEBHOOK_URL="https://your-cms.example.com/api/announcements"
# LINKEDIN_WEBHOOK_URL="https://your-social-bridge.example.com/api/linkedin"
# NEWSLETTER_WEBHOOK_URL="https://your-newsletter.example.com/api/broadcast"
