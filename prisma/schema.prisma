generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Expense {
  id               String    @id @default(cuid())
  idempotencyKey   String?   @unique
  expenseDate      DateTime?
  vendor           String?
  invoiceNumber    String?
  description      String?
  subtotalAmount   Decimal?  @db.Decimal(12, 2)
  amount           Decimal?  @db.Decimal(12, 2)
  currency         String?
  taxAmount        Decimal?  @db.Decimal(12, 2)
  category         String    @default("uncategorized")
  validationStatus String    @default("needs_review")
  validationIssues Json      @default("[]")
  sourceFileName   String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([vendor, invoiceNumber])
  @@index([validationStatus])
  @@index([createdAt])
  @@index([expenseDate])
  @@index([category])
}

model ContentPost {
  id                String          @id @default(cuid())
  title             String
  sourcePrompt      String          @db.Text
  contentType       String          @default("research_update")
  status            String          @default("draft")
  linkedinContent   String?         @db.Text
  newsletterContent String?         @db.Text
  websiteContent    String?         @db.Text
  targetChannels    Json            @default("[\"linkedin\",\"newsletter\",\"website\"]")
  metadata          Json            @default("{}")
  rejectionReason   String?
  approvedAt        DateTime?
  publishedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  publishingLogs    PublishingLog[]

  @@index([status])
  @@index([contentType])
  @@index([createdAt])
}

model PublishingLog {
  id              String      @id @default(cuid())
  postId          String
  post            ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  channel         String
  status          String
  publishedUrl    String?
  responsePayload Json?
  errorMessage    String?
  createdAt       DateTime    @default(now())

  @@index([postId])
  @@index([channel])
  @@index([createdAt])
}

model SandboxPublication {
  id         String   @id @default(cuid())
  channel    String
  externalId String
  title      String
  slug       String?
  content    Json
  url        String
  createdAt  DateTime @default(now())

  @@index([channel])
  @@index([slug])
  @@index([createdAt])
}

